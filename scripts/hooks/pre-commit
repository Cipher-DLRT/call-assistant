#!/bin/sh
# Two boot-surface budgets in one hook. Each is a FUNCTION, not an early exit: the first
# version of this returned 0 from the STATUS section whenever a commit did not touch
# STATUS.md, which would have short-circuited the advisor gate on almost every commit --
# a gate that exists and never runs. Caught before it shipped, 2026-09-07.
#
# Both gates measure the STAGED content -- the bytes this commit will actually contain --
# read with `git cat-file -s :<path>`, which returns the size of the blob in the index.
# They used to measure the working file with `wc -c`, which is the wrong version: an
# independent review reproduced it on 2026-09-07 by staging a 120,004-byte STATUS.md and
# then truncating the working copy to four bytes, at which point the gate passed. A gate
# that reads a different version of the file than the one being committed is not a gate.
top=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

# Size in bytes of a path as it is STAGED. 0 when the path is absent from the index
# (untracked, or staged for deletion -- either way it contributes nothing to the commit).
staged_bytes() {
  git cat-file -s ":$1" 2>/dev/null || echo 0
}

# STATUS.md is a boot surface: every agent in the repo re-sends it on EVERY call, so its
# size is a direct multiplier on the estate's token bill. The 14-day rule existed in
# CLAUDE.md for months and decayed anyway -- relationship-memory reached ~88,000 tokens.
# Estate law: gates are PROGRAMS or they do not exist.
#
# Refuses a commit while STATUS.md is over budget. Fix with:
#     python3 scripts/status-scrub.py <repo> --apply
# Escape hatch (same shape as the existing commit-msg hook): STATUS_BUDGET_OVERRIDE=1
check_status() {
  [ -n "$STATUS_BUDGET_OVERRIDE" ] && return 0
  BUDGET_TOKENS=${STATUS_BUDGET_TOKENS:-13000}
  # only gate when this commit actually touches STATUS.md
  git diff --cached --name-only | grep -qx 'STATUS.md' || return 0
  chars=$(staged_bytes STATUS.md)
  tokens=$((chars / 4))
  [ "$tokens" -le "$BUDGET_TOKENS" ] && return 0
  # RATCHET, as check_advisor: a commit that shrinks STATUS.md passes even while over budget.
  prevs=$(( $(git cat-file -s "HEAD:STATUS.md" 2>/dev/null || echo 0) / 4 ))
  if [ "$tokens" -lt "$prevs" ]; then
    printf '\n  STATUS.md %s -> %s tokens (over the %s budget, but SHRINKING -- allowed).\n\n' \
      "$prevs" "$tokens" "$BUDGET_TOKENS" >&2
    return 0
  fi
  cat >&2 <<MSG

  BLOCKED: STATUS.md is ~${tokens} tokens staged, over the ${BUDGET_TOKENS} budget.

  Every agent in this repo re-sends STATUS.md on every call, so this is billed
  thousands of times a day. Move the archival sections out, verbatim:

      python3 scripts/status-scrub.py $top --apply

  That moves only sections that say they are history (Prior NOW, RESURRECT-HISTORY,
  retired seat LEDGERs, RECENTLY CLOSED, anything dated past the window) into
  docs/STATUS-ARCHIVE.md. Nothing is summarised or deleted.

  Deliberate exception: STATUS_BUDGET_OVERRIDE=1 git commit ...

MSG
  return 1
}

# --- advisor boot files: the same law, learned the hard way ---------------------------------
# The files below are read IN FULL by every advisor seat at boot and re-sent on every call,
# so together they are a bigger multiplier than STATUS.md. The list is the union across the
# three repos; a file absent from a repo's index contributes 0, so one hook serves all three.
# ADVISOR-ESTATE.md was merged into ADVISOR.md on 2026-09-07 (wa 6fdeaecd) and is gone.
#
# Measured 2026-09-07, and this is the whole argument for gating them: a deliberate lossless
# compression took the set from 38,322 to 36,607 tokens on 09-06. Twenty-two hours later it was
# 39,924 -- BIGGER than before the work, ~150 tokens/hour of new doctrine. Compression is one
# act; growth is continuous, and growth won inside a day. The set is not shrunk by a merge, only
# held by a gate, which is what has kept STATUS.md under its own gate since that one landed.
#
# The budget is a CEILING ON THE SET, not per file: a rule moved between them must not read as
# a saving.
ADVISOR_FILES='docs/ADVISOR.md docs/ADVISOR-WA.md docs/ADVISOR-SF.md docs/ADVISOR-RELMEM.md'

# THE ARCHITECT SET. NEW HERE 2026-09-11, alongside docs/boot-sets.json and scripts/bootset.py.
# Before this commit relmem declared no architect ceiling at all while enforcing a 40,000
# ADVISOR_BUDGET -- so docs/ARCHITECT.md landed here (b0b9c18c) with nothing measuring what an
# architect boots. The manifest without this floor would be the mirror defect: a declared limit
# with an undeclared enforcer.
#
# THIS LIST IS A SECOND HOME FOR the manifest's roles.architect.reads and MUST AGREE WITH IT.
# relmem has no scripts/set-consistency.py yet, so nothing mechanical checks that agreement
# here -- it is checked by hand this sitting and that is a weaker control, recorded as such.
#
# IT DIFFERS FROM WORK-AUTOMATION BY ONE ENTRY, DELIBERATELY: wa charges STATUS.md on a
# measurement of five wa architect seats. relmem has had no architect seat to measure, so
# charging it here would be inheriting a result rather than holding one. See the manifest's
# RELMEM DOES NOT CHARGE STATUS.md note. Adding it later costs 10,162 tokens and couples this
# ceiling to check_status's own 13,000 budget above, with two overrides neither of which
# names the other.
ARCHITECT_FILES='docs/ARCHITECT.md docs/ADVISOR.md'

check_architect() {
  [ -n "$ARCHITECT_BUDGET_OVERRIDE" ] && return 0
  # 40,000 on the operator's word, 2026-09-11, verbatim: "You have up to 40,000 as long as
  # the architect is not going and pulling files That it needed during boot".
  # THE CONDITION IS THE RULING, NOT THE NUMBER: a set at 20,000 that sends an architect back
  # FAILS; one at 39,000 that leaves it needing nothing PASSES. It is permission to spend on
  # completeness, never a target -- and nothing here can enforce the condition, only the
  # number. relmem's side of the condition is UNMEASURED: no architect has booted here yet.
  ARCHITECT_BUDGET=${ARCHITECT_BUDGET_TOKENS:-40000}
  staged=$(git diff --cached --name-only)
  touched=0
  for xf in $ARCHITECT_FILES; do
    echo "$staged" | grep -qx "$xf" && touched=1
  done
  [ "$touched" -eq 1 ] || return 0
  xtot=0
  for xf in $ARCHITECT_FILES; do
    xc=$(staged_bytes "$xf")
    xtot=$((xtot + xc / 4))
  done
  [ "$xtot" -le "$ARCHITECT_BUDGET" ] && return 0
  # RATCHET, same reason as the advisor floor: the commit that FIXES an overrun must not be
  # the commit the gate refuses.
  xprev=0
  for xf in $ARCHITECT_FILES; do
    xp=$(git cat-file -s "HEAD:$xf" 2>/dev/null || echo 0)
    xprev=$((xprev + xp / 4))
  done
  if [ "$xtot" -lt "$xprev" ]; then
    printf '\n  architect set %s -> %s tokens (over the %s budget, but SHRINKING -- allowed).\n\n' \
      "$xprev" "$xtot" "$ARCHITECT_BUDGET" >&2
    return 0
  fi
  cat >&2 <<MSG

  BLOCKED: the architect boot set is ~${xtot} tokens staged, over the ${ARCHITECT_BUDGET} budget.

  This is the SHELL FLOOR, deliberately cruder than scripts/bootset.py -- it is here so the
  ceiling survives python3 being absent. bootset.py gives the per-address breakdown.

  These files are read IN FULL at every architect boot:
    $ARCHITECT_FILES
  docs/ADVISOR.md is in BOTH roles' sets and is charged to both, by design. Trimming it to
  make room here also moves the advisor number; check both before you cut.

  To land this commit, take something OUT:
    - an incident or origin story -> docs/ADVISOR-ORIGINS.md (in no role's set)

  Deliberate exception: ARCHITECT_BUDGET_OVERRIDE=1 git commit ...

MSG
  return 1
}

check_advisor() {
  [ -n "$ADVISOR_BUDGET_OVERRIDE" ] && return 0
  # 47,000 on the operator's word, 2026-09-11, verbatim: "open up the limit 47k", relayed
  # through the OVERSEER. Raised from 40,000, which had begun refusing rules the estate had
  # just earned. THIS is the number that binds; docs/boot-sets.json declares the same 47,000
  # and both moved in the same commit. A ceiling raised only where it is declared is a limit
  # with no enforcer -- the defect this hook is being extended to close, not to repeat.
  ADVISOR_BUDGET=${ADVISOR_BUDGET_TOKENS:-47000}
  staged=$(git diff --cached --name-only)
  touched=0
  for af in $ADVISOR_FILES; do
    echo "$staged" | grep -qx "$af" && touched=1
  done
  [ "$touched" -eq 1 ] || return 0
  atot=0
  for af in $ADVISOR_FILES; do
    ac=$(staged_bytes "$af")
    atot=$((atot + ac / 4))
  done
  [ "$atot" -le "$ADVISOR_BUDGET" ] && return 0
  # RATCHET: a commit that SHRINKS the set always passes, even while over budget. Without
  # this the gate blocks the only work that can fix it -- measured 2026-09-10, wa sat at
  # 39,993/40,000 (7 tokens of margin) and every doctrine edit, reductions included, blocked.
  prev=0
  for af in $ADVISOR_FILES; do
    pc=$(git cat-file -s "HEAD:$af" 2>/dev/null || echo 0)
    prev=$((prev + pc / 4))
  done
  if [ "$atot" -lt "$prev" ]; then
    printf '\n  advisor set %s -> %s tokens (over the %s budget, but SHRINKING -- allowed).\n\n' \
      "$prev" "$atot" "$ADVISOR_BUDGET" >&2
    return 0
  fi
  cat >&2 <<MSG

  BLOCKED: the advisor boot set is ~${atot} tokens staged, over the ${ADVISOR_BUDGET} budget.

  These files are read IN FULL at every seat boot and re-sent on every call:
    $ADVISOR_FILES
  Moving text BETWEEN them is not a saving -- this is a ceiling on the set.

  To land this commit, take something OUT of the set first:
    - an incident or origin story  -> docs/ADVISOR-ORIGINS.md (not a boot read)
    - a rule no longer enforced    -> delete it, and say so in the message
    - repo-specific detail in the shared file -> that repo's own ADVISOR-* file

  Do NOT compress by dropping rules: a merge that cut this set 39,047 -> 20,538 on
  2026-09-06 did it by deleting six gated rules (19, 25, 39, 40, 41, 42) and was rejected.

  Deliberate exception: ADVISOR_BUDGET_OVERRIDE=1 git commit ...

MSG
  return 1
}


# --- STATUS entry format: stop the growth at the point of writing --------------------------
# The two budgets above are ceilings; they fire after a file is already too big, and a sweep
# under one is cleanup, not prevention. This gate is the cause, not the symptom.
#
# CLAUDE.md already says a RECENTLY CLOSED entry is "verdict + evidence pointer, detail in a
# docs/ record file". Measured 2026-09-07 on work-automation's pre-trim STATUS.md: 51 entries
# carried a closed verdict, averaging 517 characters, median 447, longest 2,000. The
# well-formed ones are 112-266. So the rule existed and nothing applied it, and 60% of the
# file was closed work written at five times its prescribed length.
#
# Applies ONLY to entries this commit ADDS -- an entry whose leading identifier is not already
# in HEAD. Editing or correcting an existing entry never trips it, and the file's history
# never blocks an unrelated commit.
# Escape hatch, same shape as the others: STATUS_ENTRY_OVERRIDE=1
check_status_entries() {
  [ -n "$STATUS_ENTRY_OVERRIDE" ] && return 0
  git diff --cached --name-only | grep -qx 'STATUS.md' || return 0
  command -v python3 >/dev/null 2>&1 || return 0
  CAP=${STATUS_ENTRY_CAP:-350} python3 -c '
import os,re,subprocess,sys
cap=int(os.environ.get("CAP","350"))
def run(a):
    p=subprocess.run(a,capture_output=True,text=True)
    return p.stdout if p.returncode==0 else ""
new=run(["git","show",":STATUS.md"])
diff=run(["git","diff","--cached","-U0","--","STATUS.md"])
def units(t):
    out=[];cur=None;start=0
    for i,l in enumerate(t.split("\n")):
        if re.match(r"^- ",l):
            if cur:out.append((start,cur))
            cur=[l];start=i
        elif cur is not None:cur.append(l)
    if cur:out.append((start,cur))
    return out
def resurrect_span(t):
    lines=t.split("\n");a=None
    for i,l in enumerate(lines):
        if a is None:
            if re.match(r"^## RESURRECT",l): a=i
        elif re.match(r"^## ",l): return a,i
    return (a,len(lines)) if a is not None else (None,None)
res_a,res_b=resurrect_span(new)
def words(s): return set(re.sub(r"[^a-z0-9 ]"," ",s.lower()).split())
# An entry is NEW if this commit ADDED its first line and REMOVED no line resembling it.
# Two earlier designs failed and are recorded so they are not retried:
#   - a leading identifier: editing the head of an entry changed it, so a wording
#     correction read as a new entry;
#   - similarity against the whole file: entries share a skeleton (verdict word, date,
#     repo, shas, "Record: docs/..."), so a genuinely new entry scored 0.71 against an
#     unrelated one and was skipped. Measured, not assumed.
# Comparing against REMOVED lines only is what actually separates an edit from an addition.
added={l[1:] for l in diff.split("\n") if l.startswith("+") and not l.startswith("+++")}
gone=[l[1:] for l in diff.split("\n") if l.startswith("-") and not l.startswith("---") and l[1:].startswith("- ")]
def is_new(u):
    if u[0] not in added: return False
    w=words(u[0])
    for g in gone:
        q=words(g)
        if w and q and len(w&q)/len(w|q) >= 0.5: return False
    return True
CLOSED=re.compile(r"\b(CLOSED|LANDED|DEPLOYED|VERIFIED|COMPLETE|DELIVERED|ACCEPTED|SUPERSEDED)\b")
PTR=re.compile(r"\b[0-9a-f]{7,40}\b|docs/[\w./-]+")
bad=[]
for start,u in units(new):
    # RESURRECT bullets are successor instructions rewritten wholesale at §39b restarts (§17); they are not closed entries and are not scored. Everything outside that section still is.
    if res_a is not None and res_a <= start < res_b: continue
    if not is_new(u): continue
    text=" ".join(x.strip() for x in u).strip()
    if not CLOSED.search(u[0]): continue
    n=len(text)
    why=[]
    if n>cap: why.append("%d chars, cap %d"%(n,cap))
    if not PTR.search(text): why.append("no evidence pointer (a sha or a docs/ path)")
    if why: bad.append((why,re.sub(r"\s+"," ",text)[:150]))
if not bad: sys.exit(0)
print("",file=sys.stderr)
print("  BLOCKED: %d new STATUS.md entry(ies) claim a closed verdict but are not written as one."%len(bad),file=sys.stderr)
print("",file=sys.stderr)
print("  CLAUDE.md: a RECENTLY CLOSED entry is verdict + evidence pointer; the detail belongs",file=sys.stderr)
print("  in a docs/ record file. STATUS.md is re-sent on every call by every agent in this",file=sys.stderr)
print("  repo, so a 500-character entry is billed thousands of times; the record file is not.",file=sys.stderr)
print("",file=sys.stderr)
for why,t in bad:
    print("    * %s"%"; ".join(why),file=sys.stderr)
    print("      %s..."%t[:110],file=sys.stderr)
print("",file=sys.stderr)
print("  Shape that passes (a real one, 158 chars):",file=sys.stderr)
print("    - **N8NGATE-1 LANDED 20:4x (wa ff8949c): n8n.sh update = rehearsal-artifact",file=sys.stderr)
print("      refusal + auto verify/rollback.** Record: docs/session-n8ngate-1-2026-08-26.md.",file=sys.stderr)
print("",file=sys.stderr)
print("  Move the detail into the record file and cite it. Only entries this commit ADDS are",file=sys.stderr)
print("  checked -- editing an existing entry never trips this.",file=sys.stderr)
print("",file=sys.stderr)
print("  Deliberate exception: STATUS_ENTRY_OVERRIDE=1 git commit ...",file=sys.stderr)
print("",file=sys.stderr)
sys.exit(1)
'
}

# Walk-brief lint -- ADVISOR.md rule 48 and 8 rule 6. Shared with pre-push; the logic lives
# in one script (estate 46: a shared tool is fixed at the tool, not forked).
check_walk_briefs() {
  files=$(git diff --cached --name-only)
  [ -z "$files" ] && return 0
  lint=$(git rev-parse --show-toplevel)/scripts/hooks/walk-brief-lint.py
  [ -x "$lint" ] || return 0
  python3 "$lint" "" $files
}

# scripts/bootset.py counts per ROLE from docs/boot-sets.json, charges a file BOTH roles read
# to BOTH sets, and treats an address that does not resolve as an ERROR rather than a zero.
# It runs IN ADDITION to the two shell floors above, never instead of them: wa's review found
# that standing the shell check down wherever a manifest existed left a repo with NO ceiling
# at all when "roles" was empty. Fail-open here is safe BECAUSE check_advisor and
# check_architect are pure shell, always run, and cannot be edited by the data they gate.
check_bootset() {
  [ -n "$BOOTSET_OVERRIDE" ] && return 0
  [ -f "$top/docs/boot-sets.json" ] || return 0
  [ -f "$top/scripts/bootset.py" ] || return 0
  command -v python3 >/dev/null 2>&1 || return 0
  git diff --cached --name-only | grep -q . || return 0
  python3 "$top/scripts/bootset.py" check
}

check_status || exit 1
check_advisor || exit 1
check_architect || exit 1
check_bootset || exit 1
check_status_entries || exit 1
check_walk_briefs || exit 1
exit 0
